# Image generation (already configured in Production)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Paid proposals: high (default) or medium, about 3x cheaper. Change only after comparing both on real photos.
PAID_IMAGE_QUALITY=high
# Pablo, the panel and demo assistant (OpenAI Responses API, same key). Defaults to gpt-5-mini.
OPENAI_CHAT_MODEL=
STUDIO_ACCESS_PASSWORD=

# Dedicated Supabase Free project. These two NEXT_PUBLIC values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative legacy public key: NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=
# Alternative legacy server key: SUPABASE_SERVICE_ROLE_KEY

# Keep the pilot available until accounts have been verified.
SAAS_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_EMAIL_AUTH_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Enable only after verification, CAPTCHA and the daily generation budget are configured.
LIVE_TRIAL_ENABLED=false
MAX_GENERATIONS_PER_DAY=100
MAX_PROJECTS_PER_USER=150

# Payments stay disabled until credentials, products, seller details and testing are complete.
BILLING_ENABLED=false
APP_URL=https://amoblaia.vercel.app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_COLLECTOR_ID=
# Optional until the Mercado Pago Webhooks panel is available; the notification token authenticates meanwhile.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_TOKEN=
MERCADOPAGO_MODE=test
# Public Key of the same application (public by design). With it, plans are paid
# with a card on /precios and buyers need no Mercado Pago login or matching email.
# Legacy test payer, only used to reconcile abandoned orders. New card checkouts
# use the email entered in the Brick, including a test buyer in test mode.
MERCADOPAGO_TEST_PAYER_EMAIL=
CRON_SECRET=
# Team accounts (verified emails, comma separated) that open /administracion and /admin/demos.
ADMIN_EMAILS=
# Team accounts that generate without spending photos, comma separated.
UNLIMITED_EMAILS=

# Commercial details, required before billing is enabled.
SELLER_NAME=
SELLER_CUIT=
SUPPORT_EMAIL=
NEXT_PUBLIC_CONTACT_URL=

# Optional conservative cost estimate. Leave empty until current model rates are verified.
# Raw provider usage is stored independently of these rates.
IMAGE_INPUT_USD_PER_MILLION=
IMAGE_OUTPUT_USD_PER_MILLION=

# PostHog analytics (amoblaIA project). The project key is public by design.
# Host: https://us.i.posthog.com or https://eu.i.posthog.com
# Defaults to the amoblaIA project token; only production sends events unless this is set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# https://us.posthog.com or https://eu.posthog.com, matching the host above
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Meta Pixel + Conversions API. The pixel ID is public by design; the CAPI token
# is secret (store it as a Sensitive variable in Vercel, never commit it).
NEXT_PUBLIC_META_PIXEL_ID=3147699175419885
META_CAPI_TOKEN=
# Optional: code from Events Manager > Test events. Leave empty in production.
META_TEST_EVENT_CODE=
